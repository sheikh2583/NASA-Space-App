{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "outlook_region",
  "type": "object",
  "required": [
    "as_of",
    "season_to_date_percentile",
    "expected_range",
    "skill",
    "status",
    "alert"
  ],
  "properties": {
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "season_to_date_percentile": {
      "type": "number"
    },
    "expected_range": {
      "type": "object",
      "required": [
        "q10",
        "q50",
        "q90"
      ],
      "properties": {
        "q10": {
          "type": "number"
        },
        "q50": {
          "type": "number"
        },
        "q90": {
          "type": "number"
        }
      }
    },
    "skill": {
      "type": "object",
      "properties": {
        "vs_climatology": {
          "type": "number"
        },
        "vs_persistence": {
          "type": "number"
        },
        "ci": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "n_seasons": {
          "type": "integer"
        }
      }
    },
    "status": {
      "enum": [
        "skill",
        "no_demonstrated_skill"
      ]
    },
    "alert": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "none",
            "watch",
            "high"
          ]
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "current_status": {
      "type": "object",
      "properties": {
        "week_percentile": {
          "type": "number"
        },
        "level": {
          "enum": [
            "none",
            "watch",
            "high"
          ]
        },
        "data_through": {
          "type": "string",
          "format": "date"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}