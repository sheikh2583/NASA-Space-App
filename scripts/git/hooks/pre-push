#!/usr/bin/env bash
# Blocks direct pushes to main (the initial push by Sheikh sets ALLOW_MAIN_PUSH=1).
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    echo "Direct pushes to main are blocked. Use:  bash scripts/git/ship.sh"
    exit 1
  fi
done
exit 0
